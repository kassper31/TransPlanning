// Вспомогательная функция для поиска случайного контрагента
Функция НайтиСлучайногоКонтрагента(Заказчик, Перевозчик)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Контрагенты.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |    Контрагенты.Заказчик = &Заказчик
    |    И Контрагенты.Перевозчик = &Перевозчик";
    
    Запрос.УстановитьПараметр("Заказчик", Заказчик);
    Запрос.УстановитьПараметр("Перевозчик", Перевозчик);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    МассивКонтрагентов = Новый Массив;
    Пока Выборка.Следующий() Цикл
        МассивКонтрагентов.Добавить(Выборка.Ссылка);
    КонецЦикла;
    
    Если МассивКонтрагентов.Количество() = 0 Тогда
        Возврат СоздатьСлучайногоКонтрагента(Заказчик, Перевозчик);
    КонецЕсли;
    
    Возврат МассивКонтрагентов[ЮТТестовыеДанные.СлучайноеЧисло(0, МассивКонтрагентов.Количество() - 1)];
    
КонецФункции

// Вспомогательная функция для создания случайного контрагента
Функция СоздатьСлучайногоКонтрагента(Заказчик, Перевозчик)
    
    НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
    
    // Генерация случайных данных
    НовыйКонтрагент.Наименование = СгенерироватьНаименованиеКонтрагента(Заказчик, Перевозчик);
    НовыйКонтрагент.Заказчик = Заказчик;
    НовыйКонтрагент.Перевозчик = Перевозчик; 
	
	
	НовыйКонтрагент.ИНН = СлучайныйИНН();
    НовыйКонтрагент.КПП = СлучайныйИНН();
	
    НовыйКонтрагент.Контакты = "Тел: +7" + Строка(ЮТТестовыеДанные.СлучайноеЧисло(100000000, 399999999));
    
    НовыйКонтрагент.Записать();
    
    Возврат НовыйКонтрагент.Ссылка;
    
КонецФункции

