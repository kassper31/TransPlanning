// Вспомогательная функция для создания случайного груза
Функция СоздатьСлучайныйГруз()
    
    Категория = СлучайнаяКатегория();
    
    НовыйГруз = Справочники.Грузы.СоздатьЭлемент();
    
    // Генерация данных
    НовыйГруз.Наименование = СгенерироватьНаименованиеГруза(Категория);
    НовыйГруз.Категория = Категория;
    
    // Генерация веса и объема в зависимости от категории
    Если Категория = Перечисления.КатегорииГрузов.Крупногабаритный Тогда
        НовыйГруз.Вес = ЮТТестовыеДанные.СлучайноеЧисло(500, 5000); // кг
        НовыйГруз.Объем = ЮТТестовыеДанные.СлучайноеЧисло(5, 20); // м³
    ИначеЕсли Категория = Перечисления.КатегорииГрузов.Обычный Тогда
        НовыйГруз.Вес = ЮТТестовыеДанные.СлучайноеЧисло(10, 500); // кг
        НовыйГруз.Объем = ЮТТестовыеДанные.СлучайноеЧисло(0.1, 5); // м³
    Иначе
        НовыйГруз.Вес =ЮТТестовыеДанные. СлучайноеЧисло(1, 200); // кг
        НовыйГруз.Объем = ЮТТестовыеДанные.СлучайноеЧисло(0.01, 2); // м³
    КонецЕсли;
    
    // Генерация требований к ТС
    Если Категория = Перечисления.КатегорииГрузов.Опасный Тогда
        НовыйГруз.ТребованияКТС = "Требуется спецтранспорт для опасных грузов";
    ИначеЕсли Категория = Перечисления.КатегорииГрузов.Скоропортящийся Тогда
        НовыйГруз.ТребованияКТС = "Требуется рефрижератор";
    ИначеЕсли Категория = Перечисления.КатегорииГрузов.Хрупкий Тогда
        НовыйГруз.ТребованияКТС = "Требуется бережная перевозка";
    ИначеЕсли Категория = Перечисления.КатегорииГрузов.Крупногабаритный Тогда
        НовыйГруз.ТребованияКТС = "Требуется длинномерный транспорт";
    Иначе
        НовыйГруз.ТребованияКТС = "Стандартные требования";
    КонецЕсли;
    
    Попытка
        НовыйГруз.Записать();
        Возврат НовыйГруз.Ссылка;
    Исключение
        Сообщить("Ошибка при создании груза: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

