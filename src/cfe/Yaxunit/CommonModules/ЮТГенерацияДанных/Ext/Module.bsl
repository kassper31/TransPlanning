Функция СлучайныйИНН()
	Возврат Строка(Формат(ЮТТестовыеДанные.СлучайноеЧисло(10000, 99999), "ЧГ=")) 
		+ Строка(Формат(ЮТТестовыеДанные.СлучайноеЧисло(10000, 99999), "ЧГ="));
КонецФункции

Функция ГенерацияБанковскихРеквизитов() Экспорт
    Возврат "Р/с " + СлучайныйИНН() + СлучайныйИНН()
        + " в банке " + СгенерироватьНаименованиеОрганизации();
КонецФункции

// Генерирует случайное наименование организации
//
// Параметры:
//   КраткоеНаименование - Булево - если Истина, генерирует краткое название (по умолчанию Ложь)
//   Специализация - Строка - специализация организации (необязательный)
//
// Возвращаемое значение:
//   Строка - сгенерированное наименование организации
//
Функция СгенерироватьНаименованиеОрганизации(Знач КраткоеНаименование = Ложь, Знач Специализация = Неопределено) Экспорт
    
    // Базы данных для генерации названий
    ОргФормы = Новый Массив;
    ОргФормы.Добавить("ООО");
    ОргФормы.Добавить("АО");
    ОргФормы.Добавить("ЗАО");
    ОргФормы.Добавить("ПАО");
    ОргФормы.Добавить("ИП");
    ОргФормы.Добавить("НКО");
    ОргФормы.Добавить("ГК");
    
    ОсновныеЧасти = Новый Массив;
    ОсновныеЧасти.Добавить("Техно");
    ОсновныеЧасти.Добавить("Инвест");
    ОсновныеЧасти.Добавить("Пром");
    ОсновныеЧасти.Добавить("Транс");
    ОсновныеЧасти.Добавить("Строй");
    ОсновныеЧасти.Добавить("Торг");
    ОсновныеЧасти.Добавить("Фин");
    ОсновныеЧасти.Добавить("Альфа");
    ОсновныеЧасти.Добавить("Металл");
    ОсновныеЧасти.Добавить("Нефте");
    
    Суффиксы = Новый Массив;
    Суффиксы.Добавить("Групп");
    Суффиксы.Добавить("Холдинг");
    Суффиксы.Добавить("Центр");
    Суффиксы.Добавить("Сервис");
    Суффиксы.Добавить("Трейд");
    Суффиксы.Добавить("Ресурс");
    Суффиксы.Добавить("Комплекс");
    Суффиксы.Добавить("Партнер");
    
    Города = Новый Массив;
    Города.Добавить("Москва");
    Города.Добавить("Санкт-Петербург");
    Города.Добавить("Новосибирск");
    Города.Добавить("Екатеринбург");
    Города.Добавить("Казань");
    Города.Добавить("Нижний Новгород");
    Города.Добавить("Краснодар");
    
    // Определяем специализацию, если не задана
    Если Специализация = Неопределено Тогда
        Специализации = Новый Массив;
        Специализации.Добавить("Строительство");
        Специализации.Добавить("Транспорт");
        Специализации.Добавить("Финансы");
        Специализации.Добавить("IT");
        Специализации.Добавить("Производство");
        Специализации.Добавить("Торговля");
        Специализации.Добавить("Услуги");
        Специализация = Специализации[ЮТТестовыеДанные.СлучайноеЧисло(0, Специализации.Количество() - 1)];
    КонецЕсли;
    
    // Генерация названия в зависимости от специализации
    Если Специализация = "Строительство" Тогда
        ОсновныеЧасти = Новый Массив;
        ОсновныеЧасти.Добавить("Строй");
        ОсновныеЧасти.Добавить("Монолит");
        ОсновныеЧасти.Добавить("Фундамент");
        ОсновныеЧасти.Добавить("Жил");
        ОсновныеЧасти.Добавить("Град");
        Суффиксы = Новый Массив;
        Суффиксы.Добавить("Проект");
        Суффиксы.Добавить("Строй");
        Суффиксы.Добавить("Дом");
    ИначеЕсли Специализация = "Транспорт" Тогда
        ОсновныеЧасти = Новый Массив;
        ОсновныеЧасти.Добавить("Транс");
        ОсновныеЧасти.Добавить("Авто");
        ОсновныеЧасти.Добавить("Фрахт");
        ОсновныеЧасти.Добавить("Логист");
        ОсновныеЧасти.Добавить("Экспресс");
        Суффиксы = Новый Массив;
        Суффиксы.Добавить("Карго");
        Суффиксы.Добавить("Логистик");
        Суффиксы.Добавить("Транзит");
    КонецЕсли;
    
    // Выбираем случайные элементы
    ОргФорма = ОргФормы[ЮТТестовыеДанные.СлучайноеЧисло(0, ОргФормы.Количество() - 1)];
    ОсновнаяЧасть = ОсновныеЧасти[ЮТТестовыеДанные.СлучайноеЧисло(0, ОсновныеЧасти.Количество() - 1)];
    Суффикс = Суффиксы[ЮТТестовыеДанные.СлучайноеЧисло(0, Суффиксы.Количество() - 1)];
    Город = Города[ЮТТестовыеДанные.СлучайноеЧисло(0, Города.Количество() - 1)];
    
    // Варианты форматов названий
    Если КраткоеНаименование Тогда
        Форматы = Новый Массив;
        Форматы.Добавить(ОргФорма + " " + ОсновнаяЧасть + Суффикс);
        Форматы.Добавить(ОргФорма + " " + ОсновнаяЧасть + Город);
        Форматы.Добавить(ОсновнаяЧасть + Суффикс);
    Иначе
        Форматы = Новый Массив;
        Форматы.Добавить(ОргФорма + " " + ОсновнаяЧасть + Суффикс);
        Форматы.Добавить(ОргФорма + " " + ОсновнаяЧасть + Суффикс + " " + Город);
        Форматы.Добавить(ОргФорма + " " + Суффикс + " " + ОсновнаяЧасть);
        Форматы.Добавить(ОргФорма + " " + ОсновнаяЧасть + " " + Город);
        Форматы.Добавить(ОсновнаяЧасть + " " + Суффикс + " " + Город);
    КонецЕсли;
    
    Наименование = Форматы[ЮТТестовыеДанные.СлучайноеЧисло(0, Форматы.Количество() - 1)];
    
    // Для ИП генерируем ФИО
    Если ОргФорма = "ИП" Тогда
