
#Область ПрограммныйИнтерфейс

Функция СлучайнаяЗаявка(Контрагент, Организация, Направление, Услуга, Груз) Экспорт
	
	Сумма = ЮТТестовыеДанные.СлучайноеЧисло(1000, 100000); 
	
	ДокЗаявка = Документы.ЗаявкаОтЗаказчика.СоздатьДокумент();
	ДокЗаявка.Дата = ЮТТестовыеДанные.СлучайнаяДатаДо(ТекущаяДатаСеанса() - 3*24*3600, 6, "месяца");
	ДокЗаявка.Статус = Перечисления.СтатусыЗаявок.Черновик;
	ДокЗаявка.Валюта = СлучайнаяВалюта();
	ДокЗаявка.Контрагент = Контрагент;
	ДокЗаявка.Организация = Организация;
	ДокЗаявка.Направление = Направление;
	ДокЗаявка.Ответственный = Пользователи.ТекущийПользователь();
	
	ДокЗаявка.СуммаДокумента = Сумма;
	
	НоваяСтрока = ДокЗаявка.Услуги.Добавить();
	НоваяСтрока.Услуга = Услуга;
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.СуммаУпр = Сумма; 
	
	НоваяСтрока = ДокЗаявка.Грузы.Добавить();
	НоваяСтрока.Груз = Груз;
	
	ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат ДокЗаявка.Ссылка;
	
КонецФункции  

Функция СлучайныйЗапрос(Заявка = Неопределено) Экспорт 
	
	Если Заявка = Неопределено Тогда
		Заявка = ЮТГенерацияДанных.СлучайнаяЗаявка(
			ЮТГенерацияДанных.СлучайныйКонтрагент(Истина, Ложь, Ложь),
			ЮТГенерацияДанных.СлучайнаяОрганизация(Ложь),
			ЮТГенерацияДанных.СлучайноеНаправление(Ложь),
			ЮТГенерацияДанных.СлучайнаяУслуга(Ложь),
			ЮТГенерацияДанных.СлучайныйГруз(Ложь)
		);	
	КонецЕсли;
	
	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Сумма = ЮТТестовыеДанные.СлучайноеЧисло(900, ЗаявкаОбъект.СуммаДокумента);
	
	Запрос = Документы.ЗапросНаПеревозку.СоздатьДокумент();
	Запрос.Дата = ЗаявкаОбъект.Дата + 1*24*3600;     
	Запрос.Заполнить(Заявка);
	Запрос.Контрагент = ЮТГенерацияДанных.СлучайныйКонтрагент(Ложь, Истина, Ложь);
	Запрос.СуммаДокумента = Сумма;	
	Запрос.ПлановаяДатаЗагрузки = Запрос.Дата + 1*24*3600;
	Запрос.ПлановаяДатаРазгрузки = Запрос.Дата + 2*24*3600;
	Запрос.Ответственный = Пользователи.ТекущийПользователь();
	
	НоваяСтрока = Запрос.Услуги.Добавить();
	НоваяСтрока.Услуга = ЮТГенерацияДанных.СлучайнаяУслуга(Ложь);
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.СуммаУпр = Сумма;
	
	Запрос.Записать();
	
	Возврат Запрос.Ссылка;
	
КонецФункции

Функция СлучайнаяРеализацияУслуг(Заявка = Неопределено) Экспорт
	
	Если Заявка = Неопределено Тогда
		Заявка = ЮТГенерацияДанных.СлучайнаяЗаявка(
			ЮТГенерацияДанных.СлучайныйКонтрагент(Истина, Ложь, Ложь),
			ЮТГенерацияДанных.СлучайнаяОрганизация(Ложь),
			ЮТГенерацияДанных.СлучайноеНаправление(Ложь),
			ЮТГенерацияДанных.СлучайнаяУслуга(Ложь),
			ЮТГенерацияДанных.СлучайныйГруз(Ложь)
		);	
	КонецЕсли;		
	
	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Если ЗаявкаОбъект.Перевозка.Пустая() Тогда 
		Запрос = СлучайныйЗапрос(ЗаявкаОбъект.Ссылка);
		Запрос.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	Реализация = Документы.РеализацияУслуг.СоздатьДокумент();
	Реализация.Дата = ЗаявкаОбъект.Дата + 2*24*3600; 
	Реализация.Ответственный = Пользователи.ТекущийПользователь();
	Реализация.Заполнить(Заявка);   
	Реализация.Записать();
	
	Возврат Реализация.Ссылка
	
КонецФункции

Функция СлучайнаяОрганизация(Создавать = Истина) Экспорт
	
	Если Создавать Тогда  
		
        НовыйЭлемент = Справочники.Организации.СоздатьЭлемент();
        НовыйЭлемент.Наименование = СгенерироватьНаименованиеОрганизации();
        НовыйЭлемент.ИНН = СлучайныйИНН();
        НовыйЭлемент.КПП = СлучайныйИНН();
        НовыйЭлемент.БанковскиеРеквизиты = ГенерацияБанковскихРеквизитов();
        НовыйЭлемент.Записать();
		
		Возврат НовыйЭлемент;    
		
    Иначе
		
		Выборка = Справочники.Организации.Выбрать();
        МассивЭлементов = Новый Массив;
        Пока Выборка.Следующий() Цикл
            МассивЭлементов.Добавить(Выборка.Ссылка);
        КонецЦикла;

        Если МассивЭлементов.Количество() > 0 Тогда
            Возврат МассивЭлементов[ЮТТестовыеДанные.СлучайноеЧисло(0, МассивЭлементов.Количество()-1)];
        Иначе
            Возврат СлучайнаяОрганизация(Истина);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецФункции

Функция СлучайноеНаправление(Создавать = Истина) Экспорт
	
	Если Создавать Тогда
        НовыйЭлемент = Справочники.НаправленияПеревозок.СоздатьЭлемент();
        НовыйЭлемент.ПунктОтправления = ГенерацияНаименованияПункта();
        НовыйЭлемент.ПунктНазначения = ГенерацияНаименованияПункта();
        Пока НовыйЭлемент.ПунктНазначения = НовыйЭлемент.ПунктОтправления Цикл
            НовыйЭлемент.ПунктНазначения = ГенерацияНаименованияПункта();
        КонецЦикла;
        НовыйЭлемент.Расстояние = ЮТТестовыеДанные.СлучайноеЧисло(100, 10000);
        НовыйЭлемент.Записать();
        Возврат НовыйЭлемент;
    Иначе
        Выборка = Справочники.НаправленияПеревозок.Выбрать();
        МассивЭлементов = Новый Массив;
        Пока Выборка.Следующий() Цикл
            МассивЭлементов.Добавить(Выборка.Ссылка);
        КонецЦикла;

        Если МассивЭлементов.Количество() > 0 Тогда
            Возврат МассивЭлементов[ЮТТестовыеДанные.СлучайноеЧисло(0, МассивЭлементов.Количество()-1)];
        Иначе
            Возврат СлучайноеНаправление(Истина);
        КонецЕсли;
	КонецЕсли; 
	
КонецФункции

// Возвращает случайную категорию груза из перечисления КатегорииГрузов
//
// Возвращаемое значение:
//   ПеречислениеСсылка.КатегорииГрузов - случайная категория
//
Функция СлучайнаяКатегория() Экспорт
    ЗначенияКатегорий = Новый Массив;
    ЗначенияКатегорий.Добавить(Перечисления.КатегорииГрузов.Обычный);
    ЗначенияКатегорий.Добавить(Перечисления.КатегорииГрузов.Хрупкий);
    ЗначенияКатегорий.Добавить(Перечисления.КатегорииГрузов.Опасный);
    ЗначенияКатегорий.Добавить(Перечисления.КатегорииГрузов.Скоропортящийся);
    ЗначенияКатегорий.Добавить(Перечисления.КатегорииГрузов.Крупногабаритный);
    
    Возврат ЗначенияКатегорий[ЮТТестовыеДанные.СлучайноеЧисло(0, ЗначенияКатегорий.Количество() - 1)];
КонецФункции

// Возвращает случайного контрагента из справочника или создает нового
//
// Параметры:
//  Заказчик - Булево - искать/создавать контрагента-заказчика (по умолчанию Истина)
//  Перевозчик - Булево - искать/создавать контрагента-перевозчика (по умолчанию Ложь)
//  СоздаватьНового - Булево - создавать нового контрагента, если Истина (по умолчанию Истина)
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - ссылка на контрагента
//
Функция СлучайныйКонтрагент(Знач Заказчик = Истина, Знач Перевозчик = Ложь, Знач СоздаватьНового = Истина) Экспорт
    
    Если Не СоздаватьНового Тогда
        // Поиск случайного существующего контрагента
        Возврат НайтиСлучайногоКонтрагента(Заказчик, Перевозчик);
    Иначе
        // Создание нового контрагента
        Возврат СоздатьСлучайногоКонтрагента(Заказчик, Перевозчик);
    КонецЕсли;
    
КонецФункции

Функция СлучайнаяВалюта() Экспорт
	
	Результат = Справочники.Валюты.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда  
		НоваяВалюта = Справочники.Валюты.СоздатьЭлемент();
		НоваяВалюта.Код = "643";
		НоваяВалюта.Наименование = "RUB";  
		НоваяВалюта.НаименованиеПолное = "Российский рубль";  
		НоваяВалюта.ПараметрыПрописи = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2 знака"; 
		НоваяВалюта.Записать();
		Результат = НоваяВалюта.Ссылка;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

