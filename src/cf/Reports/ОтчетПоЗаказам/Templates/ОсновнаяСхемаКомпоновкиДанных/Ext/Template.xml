		<dataSource>ИсточникДанных1</dataSource>
		<query>  ВЫБРАТЬ
	ДокЗаявка.Дата КАК Дата,
	ДокЗаявка.Ссылка КАК Ссылка,
	ДокЗаявка.Контрагент КАК Контрагент,
	ДокЗаявка.Организация КАК Организация,
	ДокЗаявка.Статус КАК Статус,
	ДокЗаявка.Ответственный КАК Ответственный,
	ДокЗаявка.Направление КАК Направление,
	ДокЗаявка.Валюта КАК Валюта,
	ДокЗаявка.СуммаДокумента КАК СуммаДокумента,
	ТабГрузы.Груз КАК Груз,
	ДокЗаявка.Перевозка КАК Перевозка
ПОМЕСТИТЬ Заявки
ИЗ
	Документ.ЗаявкаОтЗаказчика.Грузы КАК ТабГрузы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаОтЗаказчика КАК ДокЗаявка
		ПО ТабГрузы.Ссылка = ДокЗаявка.Ссылка
			И (ДокЗаявка.Дата МЕЖДУ &amp;ДатаНач И &amp;ДатаКон)
			И (ДокЗаявка.Проведен)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Заявки.Дата КАК Дата,
	Заявки.Ссылка КАК Ссылка,
	Заявки.Контрагент КАК Контрагент,
	Заявки.Организация КАК Организация,
	Заявки.Статус КАК Статус,
	Заявки.Ответственный КАК Ответственный,
	Заявки.Направление КАК Направление,
	Заявки.Валюта КАК Валюта,
	Заявки.СуммаДокумента КАК СуммаДокумента,
	Заявки.Груз КАК Груз,
	Заявки.Перевозка КАК Перевозка,
	ЕСТЬNULL(ТабПеревозки.Запрос, ЗНАЧЕНИЕ(Документ.ЗапросНаПеревозку.ПустаяСсылка)) КАК Запрос,
	ЕСТЬNULL(ТабПеревозки.Запрос.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Перевозчик,
	ЕСТЬNULL(ТабПеревозки.Запрос.ПлановаяДатаЗагрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ПлановаяДатаЗагрузки,
	ЕСТЬNULL(ТабПеревозки.Запрос.ПлановаяДатаРазгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ПлановаяДатаРазгрузки
ПОМЕСТИТЬ ЗаявкиИПеревозки
ИЗ
	Заявки КАК Заявки
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Перевозка.Перевозки КАК ТабПеревозки
		ПО (Заявки.Перевозка = ТабПеревозки.Ссылка)
			И (Заявки.Груз = ТабПеревозки.Груз)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаявкиИПеревозки.Дата КАК Дата,
	ЗаявкиИПеревозки.Ссылка КАК Заявка,
	ЗаявкиИПеревозки.Контрагент КАК Контрагент,
	ЗаявкиИПеревозки.Организация КАК Организация,
	ЗаявкиИПеревозки.Статус КАК Статус,
	ЗаявкиИПеревозки.Ответственный КАК Ответственный,
	ЗаявкиИПеревозки.Направление КАК Направление,
	ЗаявкиИПеревозки.Валюта КАК Валюта,
	ЗаявкиИПеревозки.СуммаДокумента КАК СуммаДокумента,
	ЗаявкиИПеревозки.Груз КАК Груз,
	ЗаявкиИПеревозки.Перевозка КАК Перевозка,
	ЗаявкиИПеревозки.Запрос КАК Запрос,
	ЗаявкиИПеревозки.Перевозчик КАК Перевозчик,
	ЗаявкиИПеревозки.ПлановаяДатаЗагрузки КАК ПлановаяДатаЗагрузки,
	ЗаявкиИПеревозки.ПлановаяДатаРазгрузки КАК ПлановаяДатаРазгрузки,
	ЕСТЬNULL(ПоступлениеУслугУслуги.ДатаЗагрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗагрузки,
	ЕСТЬNULL(ПоступлениеУслугУслуги.ДатаРазгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРазгрузки
ИЗ
	ЗаявкиИПеревозки КАК ЗаявкиИПеревозки
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеУслуг.Услуги КАК ПоступлениеУслугУслуги
		ПО (ЗаявкиИПеревозки.Перевозка = ПоступлениеУслугУслуги.Перевозка
				И ЗаявкиИПеревозки.Запрос = ПоступлениеУслугУслуги.Запрос
				И ПоступлениеУслугУслуги.Ссылка.Проведен)</query>
	</dataSet>
