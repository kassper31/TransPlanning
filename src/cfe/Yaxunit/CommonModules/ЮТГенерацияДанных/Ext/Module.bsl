    Суффиксы.Добавить("Сервис");
    Суффиксы.Добавить("Групп");
    Суффиксы.Добавить("Трейд");
    Суффиксы.Добавить("Логистик");
    
    Города = Новый Массив;
    Города.Добавить("Москва");
    Города.Добавить("Санкт-Петербург");
    Города.Добавить("Новосибирск");
    Города.Добавить("Екатеринбург");
    Города.Добавить("Казань");
    Города.Добавить("Нижний Новгород");
    
    // Выбираем случайные элементы
    Префикс = Префиксы[ЮТТестовыеДанные.СлучайноеЧисло(0, Префиксы.Количество() - 1)];
    
    Если Заказчик И Перевозчик Тогда
        ОсновнаяЧасть1 = ОсновныеЧастиЗаказчиков[ЮТТестовыеДанные.СлучайноеЧисло(0, ОсновныеЧастиЗаказчиков.Количество() - 1)];
        ОсновнаяЧасть2 = ОсновныеЧастиПеревозчиков[ЮТТестовыеДанные.СлучайноеЧисло(0, ОсновныеЧастиПеревозчиков.Количество() - 1)];
        ОсновнаяЧасть = ОсновнаяЧасть1 + "-" + ОсновнаяЧасть2;
    ИначеЕсли Заказчик Тогда
        ОсновнаяЧасть = ОсновныеЧастиЗаказчиков[ЮТТестовыеДанные.СлучайноеЧисло(0, ОсновныеЧастиЗаказчиков.Количество() - 1)];
    ИначеЕсли Перевозчик Тогда
        ОсновнаяЧасть = ОсновныеЧастиПеревозчиков[ЮТТестовыеДанные.СлучайноеЧисло(0, ОсновныеЧастиПеревозчиков.Количество() - 1)];
    Иначе
        ОсновнаяЧасть = "Коммерческий";
    КонецЕсли;
    
    Суффикс = Суффиксы[ЮТТестовыеДанные.СлучайноеЧисло(0, Суффиксы.Количество() - 1)];
    Город = Города[ЮТТестовыеДанные.СлучайноеЧисло(0, Города.Количество() - 1)];
    
    // Варианты форматов названий
    Форматы = Новый Массив;
    Форматы.Добавить(Префикс + " " + ОсновнаяЧасть + " " + Суффикс);
    Форматы.Добавить(Префикс + " " + ОсновнаяЧасть + " " + Суффикс + " " + Город);
    Форматы.Добавить(Префикс + " " + Суффикс + " " + ОсновнаяЧасть);
    Форматы.Добавить(ОсновнаяЧасть + " " + Суффикс);
    
    Возврат Форматы[ЮТТестовыеДанные.СлучайноеЧисло(0, Форматы.Количество() - 1)];
    
КонецФункции

